{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Поддержка JS */
    "allowJs": true,
    "checkJs": false,

    /* Strict Rules */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],

    /* Алиасы (чтобы IDE понимала @/) */
    // "ignoreDeprecations": "6.0",
    // "baseUrl": ".",
    // "paths": {
    //   "@/*": ["src/*"]
    // }
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "draft/draft-elementUtils.js"],
  "exclude": ["node_modules", "dist"]
}
